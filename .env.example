# Local preview / production HTTP port. NSW imagery needs no API key.
PORT=4173
# Production server only; defaults to all interfaces for container networking.
HOST=0.0.0.0
# Set to 1 only behind a trusted reverse proxy forwarding the public scheme/host.
TRUST_PROXY=0
# Host-side port for compose.example.yml; the container still listens on 4173.
PLANSCAN_HOST_PORT=4173
